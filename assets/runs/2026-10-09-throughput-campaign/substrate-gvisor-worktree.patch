// EXPERIMENT (agents-tco east worktree, 2026-10-09): reusable sandbox cgroups.
//
// runsc creates a cgroup v2 leaf per container at create and removes it at
// delete. On a 100-worker node the mkdir/rmdir (cgroup_mutex) and the
// cgroup.procs attaches runsc performs on the way are a measurable part of
// the pause-sandbox create convoy (host probe under 5-8 swaps/s: mkdir 7-24 ms,
// attach pair 20-60 ms, rmdir up to 150 ms). runsc only removes a cgroup it
// created itself, so the worker keeps a pool of leaves ("ateom-slot-N") under
// its delegated scope and points both of an actor's containers at one of them
// through the OCI spec's cgroupsPath: runsc finds the directory, writes the
// actor's limits into it (so --cpu-num-from-quota and the memory limit still
// work) and leaves it in place at delete. After the teardown the worker
// kills whatever is left in the slot and hands it to the next activation.
// ATE_CGROUP_SLOTS=0 disables this and restores the per-container leaves.

const cgroupSlotPrefix = "ateom-slot-"

// cgroupSlots is the per-worker pool of reusable sandbox cgroups.
type cgroupSlots struct {
	root    string
	enabled bool

	mu      sync.Mutex
	free    []string
	next    int
	byActor map[string]string
}

func newCgroupSlots(root string) *cgroupSlots {
	enabled := cgroupSlotsDefault
	if v := os.Getenv("ATE_CGROUP_SLOTS"); v != "" {
		enabled = v != "0"
	}
	return &cgroupSlots{root: root, enabled: enabled, byActor: map[string]string{}}
}

// acquire returns the leaf name (relative to root) the actor's containers
// should use, creating a new slot when none is free. "" means slots are
// disabled and the caller keeps runsc's own per-container cgroups.
func (c *cgroupSlots) acquire(actorUID string) (string, error) {
	if c == nil || !c.enabled {
		return "", nil
	}
	c.mu.Lock()
	defer c.mu.Unlock()
	if leaf, ok := c.byActor[actorUID]; ok {
		return leaf, nil
	}
	var leaf string
	if n := len(c.free); n > 0 {
		leaf = c.free[n-1]
		c.free = c.free[:n-1]
	} else {
		leaf = cgroupSlotPrefix + strconv.Itoa(c.next)
		c.next++
	}
	// MkdirAll rather than Mkdir: a slot runsc happened to remove (it should
	// not, it does not own it) is simply re-created.
	if err := os.MkdirAll(filepath.Join(c.root, leaf), 0o755); err != nil {
		return "", fmt.Errorf("while creating sandbox cgroup slot %s: %w", leaf, err)
	}
	c.byActor[actorUID] = leaf
	return leaf, nil
}

// leafOf is the slot the actor currently holds, if any.
func (c *cgroupSlots) leafOf(actorUID string) (string, bool) {
	if c == nil || !c.enabled {
		return "", false
	}
	c.mu.Lock()
	defer c.mu.Unlock()
	leaf, ok := c.byActor[actorUID]
	return leaf, ok
}

// release returns the actor's slot to the pool once nothing runs in it. Any
// process still there (runsc's delete is best-effort) is killed through
// cgroup.kill first; a slot that cannot be emptied is dropped, not reused.
func (c *cgroupSlots) release(ctx context.Context, actorUID string) {
	if c == nil || !c.enabled {
		return
	}
	c.mu.Lock()
	leaf, ok := c.byActor[actorUID]
	delete(c.byActor, actorUID)
	c.mu.Unlock()
	if !ok {
		return
	}
	if err := ateomcgroup.KillLeafUnder(ctx, c.root, leaf); err != nil {
		slog.WarnContext(ctx, "Sandbox cgroup slot not emptied; dropping it", slog.String("slot", leaf), slog.Any("err", err))
		return
	}
	if _, err := os.Stat(filepath.Join(c.root, leaf)); err != nil && !errors.Is(err, fs.ErrNotExist) {
		slog.WarnContext(ctx, "Sandbox cgroup slot unreadable; dropping it", slog.String("slot", leaf), slog.Any("err", err))
		return
	}
	c.mu.Lock()
	c.free = append(c.free, leaf)
	c.mu.Unlock()
}
