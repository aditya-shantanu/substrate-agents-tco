+// runscSharedRoot is the --shared-root handed to every runsc invocation.
+//
+// EXPERIMENT (agents-tco east worktree, 2026-10-08): --root is per actor
+// (runscStateDir), and runsc keeps the gofers' empty "null" network namespace
+// pinned under --shared-root, which defaults to --root. So every sandbox
+// create unshared and pinned a fresh network namespace and every delete tore
+// one down (runsc logs "Pinned null network namespace at .../runsc-state/null-netns"
+// and warns "gVisor startup is slower if --root (or --shared-root) is not
+// reused across multiple sandboxes"). Namespace create/teardown serialises
+// node-wide in the kernel (rtnl_lock, cleanup_net), which is what made
+// pause_create grow from 90 ms alone to 300-650 ms at 8-12 swaps/s on a
+// 100-worker node. One directory per worker pod lets all its sandboxes share
+// the one pinned namespace. ATE_RUNSC_SHARED_ROOT overrides the path; "off"
+// restores the per-actor default.
+func runscSharedRoot() string {
+	switch v := os.Getenv("ATE_RUNSC_SHARED_ROOT"); v {
+	case "":
+		if !runscSharedRootOnDef {
+			return "off"
+		}
+		return "/run/ateom-runsc-shared"
+	default:
+		return v
+	}
+}
+
+// runscSharedRootFor is the --shared-root for a sandbox whose --root is
+// stateDir: the shared directory, or stateDir itself when disabled ("off"),
+// which is runsc's own default.
+func runscSharedRootFor(stateDir string) string {
+	if dir := runscSharedRoot(); dir != "off" {
+		return dir
+	}
+	return stateDir
+}
+
+// runscIgnoreCgroups is the value of runsc's --ignore-cgroups.
+//
+// DIAGNOSTIC BUILD (agents-tco east, 2026-10-09), not a fix: with the sandbox
+// network namespaces pooled and the gofer namespace shared, `runsc create` of
+// the pause container still grew from ~90 ms alone to ~530 ms at 8 swaps/s,
+// almost all of it between runsc's startup banner and "Gofer started", which
+// is where runsc creates and joins the per-container cgroup (cgroup_mutex and
+// the global cgroup_threadgroup_rwsem writer on every create, rmdir on every
+// delete; Substrate gives every container its own cgroup, ocispec.GVisorCgroupLeaf).
+// Setting this to true skips all cgroup work so the hypothesis can be measured;
+// it also drops the host-side per-actor memory limit (the sentry's vCPU count
+// still comes from the spec's cpu quota via --cpu-num-from-quota).
+// Measured 2026-10-09 (iteration 5): without a cgroup runsc sizes the sentry from
+// the host (192 vCPUs), which made every stage slower, so this now defaults to
+// false; ATE_RUNSC_IGNORE_CGROUPS=1 re-enables the diagnostic.
+func runscIgnoreCgroups() string {
+	if os.Getenv("ATE_RUNSC_IGNORE_CGROUPS") == "1" {
+		return "true"
+	}
+	return "false"
+}
+
+// runscDebug / runscDebugLog: DIAGNOSTIC runsc debug logging into the actor's
+// root dir (<root>/runsc-debug-logs/<cmd>-...). ATE_RUNSC_DEBUG=1 enables it;
+// off by default because it costs noticeable time per command.
+func runscDebug() string {
+	if os.Getenv("ATE_RUNSC_DEBUG") == "1" || runscDebugDefault {
+		return "true"
+	}
+	return "false"
+}
+
+func runscDebugLog(actorDirs *ateompb.ActorDirs) string {
+	if runscDebug() != "true" {
+		return ""
+	}
+	return filepath.Join(actorDirs.GetRootDir(), "runsc-debug-logs") + "/"
+}
+
+// ensureSharedRoot creates the shared directory; runsc expects it to exist.
+func ensureSharedRoot() {
+	if dir := runscSharedRoot(); dir != "off" {
+		_ = os.MkdirAll(dir, 0o700)
+	}
+}
