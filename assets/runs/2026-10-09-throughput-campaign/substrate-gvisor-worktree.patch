// unshare/veth/nftables syscalls and, above all, the kernel's single
// cleanup_net worker (which holds rtnl_lock while it unregisters the dying
// namespaces' veths) serialise node-wide. The host looked idle the whole time.
//
// A torn-down network goes back to a per-process free list with its names
// removed; the next activation on this worker bind-mounts the pooled
// namespaces under the new actor's names and re-applies the actor-side
// address and default route (runsc deletes them from the veth when it claims
// the interface, and does not put them back). The gateway side, the nftables
// redirect and the per-namespace sysctl survive untouched. Networks are only
// interchangeable within one egress port, which is a per-worker constant.
//
// ATE_NETNS_POOL sets how many idle networks a worker keeps (default 16;
// 0 restores the create/destroy-per-activation behaviour).

// sandboxNetworkPool keeps idle sandbox networks for reuse.
type sandboxNetworkPool struct {
	mu   sync.Mutex
	free []*SandboxNetwork
	max  int

	// counters, for the log line on every take.
	hits, misses, returned, dropped uint64
}

var netPool = func() *sandboxNetworkPool {
	n := 16
	if v, err := strconv.Atoi(os.Getenv("ATE_NETNS_POOL")); err == nil && v >= 0 {
		n = v
	}
	return &sandboxNetworkPool{max: n}
}()

// enabled reports whether networks are pooled at all.
func (p *sandboxNetworkPool) enabled() bool { return p.max > 0 }

// take returns an idle network for egressPort, or nil.
func (p *sandboxNetworkPool) take(egressPort uint16) *SandboxNetwork {
	p.mu.Lock()
	defer p.mu.Unlock()
	for i, n := range p.free {
		if n.egressPort == egressPort {
			p.free = append(p.free[:i], p.free[i+1:]...)
			p.hits++
			return n
		}
	}
	p.misses++
	return nil
}

// put keeps n for reuse; false when the pool is full (the caller destroys it).
func (p *sandboxNetworkPool) put(n *SandboxNetwork) bool {
	p.mu.Lock()
	defer p.mu.Unlock()
	if len(p.free) >= p.max {
		p.dropped++
		return false
	}
	p.free = append(p.free, n)
	p.returned++
	return true
}

func (p *sandboxNetworkPool) stats() []slog.Attr {
	p.mu.Lock()
	defer p.mu.Unlock()
	return []slog.Attr{
		slog.Int("idle", len(p.free)), slog.Int("max", p.max),
		slog.Uint64("hits", p.hits), slog.Uint64("misses", p.misses),
		slog.Uint64("returned", p.returned), slog.Uint64("dropped", p.dropped),
	}
}

// takePooledNetwork adopts an idle network for cfg's actor. It returns nil when
// none is idle or adoption fails (the failed network is destroyed), and the
// caller builds a fresh one.
func takePooledNetwork(ctx context.Context, cfg SandboxNetworkConfig) *SandboxNetwork {
	if !netPool.enabled() || !cfg.Veth {
		return nil
	}
	n := netPool.take(cfg.EgressPort)
	if n == nil {
		return nil
	}
	if err := n.adopt(ctx, cfg.ActorUID); err != nil {
		slog.WarnContext(ctx, "Pooled sandbox network could not be adopted; building a fresh one", slog.Any("err", err))
		n.destroy()
		return nil
	}
	slog.LogAttrs(ctx, slog.LevelInfo, "Reused pooled sandbox network", append(netPool.stats(), slog.String("actorUID", cfg.ActorUID))...)
	return n
}

// adopt prepares n for actorUID: it restores the actor-side address and
// default route, which runsc removes when it takes the interface over, and
// records the handle path runsc should open. The namespaces are not given
// names: the runtime reaches the actor namespace through the worker's own
// descriptor (/proc/<pid>/fd/<n>, see NSPath), which spares two bind mounts
// and two unmounts of the mount-namespace lock per activation. The name-based
// path is kept when ATE_NETNS_BIND_NAMES=1.
func (n *SandboxNetwork) adopt(ctx context.Context, actorUID string) error {
	if bindNames() {
		actorNSName := nodepath.ActorNetNSName(actorUID)
		if err := netns.BindNamed(n.RuntimeNetNS, actorNSName); err != nil {
			return fmt.Errorf("while naming the pooled actor netns %s: %w", actorNSName, err)
		}
		gatewayNSName := SandboxGatewayNetNSName(actorUID)
		if err := netns.BindNamed(n.GatewayNetNS, gatewayNSName); err != nil {
			_ = netns.RemoveNamed(actorNSName)
			return fmt.Errorf("while naming the pooled gateway netns %s: %w", gatewayNSName, err)
		}
	}
	if err := netns.Do(ctx, n.RuntimeNetNS, func(context.Context) error {
		if err := linkUp("lo"); err != nil {
			return err
		}
		eth0, err := netlink.LinkByName(ActorVethName)
		if err != nil {
			return err
		}
		if err := netlink.AddrReplace(eth0, ActorVethAddr); err != nil {
			return fmt.Errorf("while re-assigning the actor address: %w", err)
		}
		if err := netlink.LinkSetUp(eth0); err != nil {
			return err
		}
		return netlink.RouteReplace(&netlink.Route{
			LinkIndex: eth0.Attrs().Index,
			Gw:        ActorVethGwIP,
		})
	}); err != nil {
		if bindNames() {
			_ = netns.RemoveNamed(nodepath.ActorNetNSName(actorUID))
			_ = netns.RemoveNamed(SandboxGatewayNetNSName(actorUID))
		}
		return err
	}
	n.ActorUID = actorUID
	if !bindNames() {
		n.NSPath = fmt.Sprintf("/proc/%d/fd/%d", os.Getpid(), int(n.RuntimeNetNS))
	}
	return nil
}

// bindNames reports whether pooled namespaces are also bind-mounted under the
// actor's names (the pre-pool layout); default off.
func bindNames() bool { return os.Getenv("ATE_NETNS_BIND_NAMES") == "1" }

// release removes n's names and parks it in the pool. It reports false when the
// network was not pooled (full pool, or not a pooled shape) and the caller must
// destroy it; the names are removed either way.
func (n *SandboxNetwork) release() (pooled bool, err error) {
	for _, name := range []string{nodepath.ActorNetNSName(n.ActorUID), SandboxGatewayNetNSName(n.ActorUID)} {
		if rerr := netns.RemoveNamed(name); rerr != nil {
			err = fmt.Errorf("while deleting netns %s: %w", name, rerr)
		}
	}
	if err != nil || !netPool.enabled() || n.RuntimeNetNS <= 0 || n.GatewayNetNS <= 0 || n.GatewayNetNS == n.RuntimeNetNS {
		return false, err
	}
	n.ActorUID = ""
	return netPool.put(n), nil
}

// destroy closes the handles; with the names already gone the namespaces die
// with the last reference.
func (n *SandboxNetwork) destroy() {
	if n.GatewayNetNS > 0 && n.GatewayNetNS != n.RuntimeNetNS {
		_ = n.GatewayNetNS.Close()
	}
	if n.RuntimeNetNS > 0 {
		_ = n.RuntimeNetNS.Close()
	}
}
