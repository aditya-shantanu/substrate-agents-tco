@@ -76,9 +76,21 @@ func reseedGuestCRNG(ctx context.Context, ac *kata.AgentClient) error {
 	if err != nil {
 		return err
 	}
-	rctx, cancel := context.WithTimeout(ctx, 5*time.Second)
-	defer cancel()
-	return ac.ReseedRandomDev(rctx, nonce)
+	// EXPERIMENT (agents-tco worktree): under a dense restore load the agent of a
+	// freshly resumed guest occasionally takes longer than 5 s to answer, and a
+	// failed reseed CRASHES the actor (measured: ~1 crash per 500-1000 restores,
+	// "agent ReseedRandomDev: context deadline exceeded"). Allow 15 s and one retry.
+	var err2 error
+	for attempt := 0; attempt < 2; attempt++ {
+		rctx, cancel := context.WithTimeout(ctx, 15*time.Second)
+		err2 = ac.ReseedRandomDev(rctx, nonce)
+		cancel()
+		if err2 == nil || ctx.Err() != nil {
+			return err2
+		}
+		slog.WarnContext(ctx, "guest CRNG reseed failed; retrying", slog.Int("attempt", attempt+1), slog.Any("err", err2))
+	}
+	return err2
 }
 
