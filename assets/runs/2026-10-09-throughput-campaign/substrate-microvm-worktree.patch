+// Decoders are pooled too: each zstd.NewReader allocates its window and history
+// buffers afresh, and concurrent restores paid for that in page faults the same
+// way the uploads did.
+var zstdDecPool = sync.Pool{New: func() any {
+	d, err := zstd.NewReader(nil, zstd.WithDecoderConcurrency(1))
+	if err != nil {
+		panic(err) // options are compile-time constants
+	}
+	return d
+}}
+
+// getDecoder returns a pooled decoder reading src.
+func getDecoder(src io.Reader) (*zstd.Decoder, error) {
+	d := zstdDecPool.Get().(*zstd.Decoder)
+	if err := d.Reset(src); err != nil {
+		zstdDecPool.Put(d)
+		return nil, err
+	}
+	return d, nil
+}
+
+// putDecoder detaches the decoder from its reader and returns it to the pool.
+func putDecoder(d *zstd.Decoder) {
+	_ = d.Reset(nil)
+	zstdDecPool.Put(d)
+}
