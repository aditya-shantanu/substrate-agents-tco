+// hostedNetNSPath is the descriptor path of a pooled sandbox namespace, or ""
+// when the actor's namespace carries its /run/netns name.
+func hostedNetNSPath(h *hostedActor) string {
+	if h == nil || h.network == nil || h.network.Network == nil {
+		return ""
+	}
+	return h.network.Network.NSPath
+}
