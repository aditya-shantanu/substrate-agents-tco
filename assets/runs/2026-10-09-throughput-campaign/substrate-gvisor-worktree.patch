+// leanTeardown reports whether the post-checkpoint teardown skips the
+// kill/wait/state round trips (default on; ATE_LEAN_TEARDOWN=0 restores the
+// full sequence).
+func leanTeardown() bool {
+	if v := os.Getenv("ATE_LEAN_TEARDOWN"); v != "" {
+		return v != "0"
+	}
+	return leanTeardownDefault
+}
+
+// terminateCheckpointedWorkload is terminateWorkload for a sandbox that a FULL
+// checkpoint has already stopped: application containers are deleted first and
+// the pause (root) container last, each with `runsc delete -force`, with no
+// kill, wait or state calls in between. A delete that fails because the
+// sandbox is already gone is logged, not returned: the state and pid-file
+// directories are reset right after, and atelet wipes the bundles.
+func (s *AteomService) terminateCheckpointedWorkload(ctx context.Context, actorRef resources.ActorRef, actorUID, runscPath string, actorDirs *ateompb.ActorDirs, containers []*ateompb.Container) error {
+	var errs []error
+	if err := s.tunnel.Deactivate(ctx, resources.ActorAttribution{Ref: actorRef, UID: actorUID}); err != nil {
+		errs = append(errs, fmt.Errorf("while deactivating actor networking: %w", err))
+	}
+	rcmd := &runsc{path: runscPath, actorUID: actorUID, actorDirs: actorDirs}
+	cleanupCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 30*time.Second)
+	defer cancel()
+	names := make([]string, 0, len(containers)+1)
+	for _, ctr := range containers {
+		names = append(names, ctr.GetName())
+	}
+	names = append(names, ocispec.PauseContainer)
+	for _, name := range names {
+		if err := rcmd.cmdDelete(cleanupCtx, name); err != nil {
+			slog.InfoContext(ctx, "runsc delete after checkpoint reported an error (sandbox already stopped)", slog.String("container", name), slog.Any("err", err))
+		}
+	}
+	if err := resetRunscStateAndPidFileDirs(actorDirs); err != nil {
+		errs = append(errs, fmt.Errorf("while resetting runsc state and pid file dirs: %w", err))
+	}
+	if err := imagecache.UnmountAllUnder(actorDirs.GetOciBundleDir()); err != nil {
+		errs = append(errs, fmt.Errorf("while unmounting bundle rootfs overlays: %w", err))
+	}
+	if err := s.unhostActor(ctx, actorUID); err != nil {
+		errs = append(errs, fmt.Errorf("while cleaning up actor network: %w", err))
+	}
+	s.slots.release(cleanupCtx, actorUID)
+	return errors.Join(errs...)
+}
