+func putDecoder(d *zstd.Decoder) {
+	_ = d.Reset(nil)
+	zstdDecPool.Put(d)
+}
+
+// writerOnly hides dst's ReadFrom so io.CopyBuffer uses the caller's buffer: the
+// generic os.File.ReadFrom path copied the decoded image in 32 KiB pieces (4,000
+// write syscalls per 128 MiB; ~4 cores at 12 restores/s).
+type writerOnly struct{ io.Writer }
+
+const copyBufSize = 1 << 20
+
+var copyBufs = make(chan []byte, 64)
+
+func getCopyBuf() []byte {
+	select {
+	case b := <-copyBufs:
+		return b
+	default:
+		return make([]byte, copyBufSize)
+	}
+}
+
+func putCopyBuf(b []byte) {
+	select {
+	case copyBufs <- b:
+	default:
+	}
+}
